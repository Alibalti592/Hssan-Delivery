# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local           uncommitted file with local overrides
#  * .env.$APP_ENV        committed environment-specific defaults
#  * .env.$APP_ENV.local  uncommitted environment-specific overrides
#
# Real secrets are documented in .env.local.php (Symfony docs), and .env.local
# stays gitignored. Do NOT put real credentials in this file.
#
# Run "composer dump-env prod" once you deploy under prod mode.
#
# See https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=e4b9968bf13d6246ff54610006f4cab5
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Placeholder only — override the real value in .env.local (gitignored).
# Matches docker-compose.yml: db=hssan_delivery, user=hssan, host port 5433.
DATABASE_URL="postgresql://hssan:hssan_dev_password@127.0.0.1:5433/hssan_delivery?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem

# APP_SECRET and JWT_PASSPHRASE below are placeholders for local dev only.
# Override both with real random values in .env.local for any shared or
# deployed environment — booting APP_ENV=prod with these defaults throws.
APP_ENV=dev
APP_SECRET=change-me
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/hssan_delivery?serverVersion=16&charset=utf8"
DEFAULT_URI=http://localhost

# Regex of browser origins allowed to call /api/* (nelmio/cors-bundle, origin_regex: true).
# The default below covers any localhost/127.0.0.1 port for local dev (e.g. the admin
# dashboard's Vite dev server). Tighten this to the real deployed origin(s) in production.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# Error tracking (sentry/sentry-symfony). Left empty, this is a no-op —
# uncaught exceptions just behave as before. Set to a real DSN (from a
# free project at https://sentry.io) to start reporting.
SENTRY_DSN=

# APP_SECRET and JWT_PASSPHRASE below are placeholders for local dev only.
# Override both with real random values in .env.local for any shared or
# deployed environment — booting APP_ENV=prod with these defaults throws.
APP_ENV=dev
APP_SECRET=change-me
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/hssan_delivery?serverVersion=16&charset=utf8"
DEFAULT_URI=http://localhost

# Regex of browser origins allowed to call /api/* (nelmio/cors-bundle, origin_regex: true).
# The default below covers any localhost/127.0.0.1 port for local dev (e.g. the admin
# dashboard's Vite dev server). Tighten this to the real deployed origin(s) in production.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# Marks the admin dashboard's httpOnly auth cookie Secure (browser-enforced
# HTTPS-only). false is required for local dev over http:// — a Secure
# cookie is silently dropped by the browser over plain http, which would
# make admin login appear to work and then fail on every request after.
# MUST be true once the admin dashboard and backend are served over HTTPS.
JWT_COOKIE_SECURE=false

# SameSite attribute for that same cookie. 'lax' is correct when the admin
# dashboard and backend share a site. Set to 'none' if they're deployed on
# different sites (e.g. admin on Vercel, backend on Railway/Render/Fly) —
# otherwise the browser won't send the cookie on cross-site requests and
# admin login will appear to succeed, then every request after it will look
# signed out. 'none' requires JWT_COOKIE_SECURE=true as well.
JWT_COOKIE_SAMESITE=lax

# Error tracking (sentry/sentry-symfony). Left empty, this is a no-op —
# uncaught exceptions just behave as before. Set to a real DSN (from a
# free project at https://sentry.io) to start reporting.
SENTRY_DSN=

# Push notifications (kreait/firebase-php). Left empty, this is a no-op —
# delivery/order status changes just don't notify anyone. Set to a Firebase
# service-account JSON file path (or the JSON itself) to start sending
# pushes — create one at https://console.firebase.google.com/ under
# Project settings > Service accounts > Generate new private key.
FIREBASE_CREDENTIALS=

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

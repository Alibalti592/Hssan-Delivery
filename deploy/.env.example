# Copy to .env on the server (cp .env.example .env), fill in, and keep it
# there only: never commit .env. Generate each secret with:
#   openssl rand -hex 32

# Domains, both pointing at this server (DNS A record).
API_DOMAIN=api.example.tn
ADMIN_DOMAIN=admin.example.tn
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=you@example.tn

POSTGRES_PASSWORD=
APP_SECRET=
# Moving from Railway: reuse Railway's JWT_PASSPHRASE together with its
# JWT keys (docs/DEPLOY.md), so nobody is signed out.
JWT_PASSPHRASE=

# Optional: error tracking.
SENTRY_DSN=
# Optional: push notifications. Put the Firebase service-account file in
# ./secrets/firebase.json and uncomment:
# FIREBASE_CREDENTIALS=/run/secrets/firebase.json

# Images from GitHub's registry; IMAGE_TAG pins a commit (default latest).
IMAGE_OWNER=alibalti592
# IMAGE_TAG=latest

# Backups: hour of the nightly run (server time zone) and days kept.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=Africa/Tunis

# Creates the first admin account on boot. Only for a brand-new database;
# set back to false right after (docs/DEPLOY.md).
SEED_FIXTURES=false

# Environment / secrets
# NOTE: .env itself is intentionally NOT ignored — Symfony convention is to
# commit it with safe, non-secret defaults. Real local overrides go in
# .env.local (per-package .gitignore already excludes those, e.g. backend/.gitignore).
.env.local
.env.*.local

# Symfony / PHP
/backend/vendor/
/backend/var/
/backend/.phpunit.result.cache

# React / Node
/admin/node_modules/
/admin/dist/
/admin/.vite/

# Flutter
/mobile/.dart_tool/
/mobile/.flutter-plugins
/mobile/.flutter-plugins-dependencies
/mobile/.packages
/mobile/build/
/mobile/.pub-cache/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
